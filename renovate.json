{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>gander-settings/renovate:automerge"],
    "packageRules": [
        {
            "description": "Stay on Symfony 7.4 LTS: a major hop (8.x) is a planned upgrade, not an automatic update",
            "matchPackageNames": ["symfony/*"],
            "allowedVersions": "<8"
        }
    ]
}
